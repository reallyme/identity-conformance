{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://really.me/schemas/identity-conformance/certification-evidence-v1.json",
  "title": "ReallyMe OIDF Certification Evidence",
  "description": "Manifest for reviewed, redacted OIDF certification evidence. Raw runner output and credentials are prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "suite",
    "components",
    "runs",
    "artifacts",
    "classification",
    "redaction_review",
    "public_disclosure_review"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "classification": { "const": "public" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "immutable_digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "immutable_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "host"],
      "properties": {
        "repository": { "const": "https://gitlab.com/openid/conformance-suite.git" },
        "commit": { "const": "23353b36957d6466010de767c812d2c91ed37638" },
        "host": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit"],
        "properties": {
          "repository": { "type": "string", "pattern": "^https://github\\.com/reallyme/[A-Za-z0-9_.-]+$" },
          "commit": { "$ref": "#/$defs/gitCommit" }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plan_id", "expression", "expected_modules", "passed_modules", "result"],
        "properties": {
          "plan_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "expression": { "type": "string", "minLength": 1, "maxLength": 2048, "not": { "pattern": ":" } },
          "expected_modules": { "type": "integer", "minimum": 1 },
          "passed_modules": { "type": "integer", "minimum": 1 },
          "result": { "const": "PASSED" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type"],
        "properties": {
          "path": { "type": "string", "pattern": "^artifacts/[A-Za-z0-9][A-Za-z0-9._/-]*$", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
          "sha256": { "$ref": "#/$defs/sha256" },
          "media_type": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "redaction_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "reviewer", "reviewed_at"],
      "properties": {
        "completed": { "const": true },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewed_at": { "type": "string", "format": "date-time" }
      }
    },
    "public_disclosure_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "reviewer", "reviewed_at"],
      "properties": {
        "completed": { "const": true },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewed_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
