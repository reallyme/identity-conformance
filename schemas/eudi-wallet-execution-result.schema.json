{
  "$comment": "SPDX-FileCopyrightText: 2026 ReallyMe Technologies Limited\nSPDX-License-Identifier: MIT OR Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://really.me/schemas/identity-conformance/eudi-wallet-execution-result-v3.json",
  "title": "ReallyMe EUDI Wallet engineering execution result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "result", "created_at", "framework_version", "framework_revision", "workflow_revision", "candidate_sha256", "component", "target", "package_bundle_sha256", "component_attestation_sha256", "package_evidence", "source_locks", "normative_ledgers", "coverage", "test_execution", "framework_probes", "checks", "assertions", "evidence_policy"],
  "properties": {
    "schema": {"const": "reallyme.identity.eudi_wallet_execution_result.v3"},
    "plan_id": {"const": "eudi-wallet-engineering-v1"},
    "result": {"enum": ["passed", "failed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "framework_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "framework_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workflow_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "component": {"$ref": "eudi-wallet-deployment-manifest.schema.json#/properties/component"},
    "target": {"$ref": "eudi-wallet-deployment-manifest.schema.json#/$defs/target"},
    "package_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "component_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "package_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight_run_id", "preflight_job_id", "fuzz_run_id", "protobuf_ci_run_id", "rust_ci_run_id", "crate_count", "crates", "crate_inventory_sha256", "evidence_count", "evidence_inventory_sha256", "cargo_lock_sha256"],
      "properties": {
        "preflight_run_id": {"type": "integer", "minimum": 1},
        "preflight_job_id": {"type": "integer", "minimum": 1},
        "fuzz_run_id": {"type": "integer", "minimum": 1},
        "protobuf_ci_run_id": {"type": "integer", "minimum": 1},
        "rust_ci_run_id": {"type": "integer", "minimum": 1},
        "crate_count": {"type": "integer", "minimum": 1, "maximum": 128},
        "crates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "file", "size", "sha256"],
            "properties": {
              "name": {"type": "string", "pattern": "^reallyme-wallet(?:-[a-z0-9][a-z0-9-]{0,63})?$"},
              "version": {"$ref": "eudi-wallet-deployment-manifest.schema.json#/$defs/semver"},
              "file": {"type": "string", "pattern": "^reallyme-wallet(?:-[a-z0-9][a-z0-9-]{0,63})?-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.crate$"},
              "size": {"type": "integer", "minimum": 1, "maximum": 67108864},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "crate_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_count": {"const": 7},
        "evidence_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "cargo_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_locks": {"$ref": "eudi-wallet-deployment-manifest.schema.json#/properties/source_locks"},
    "normative_ledgers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eu_arf_sha256", "eu_fcaf_sha256", "eu_technical_specifications_sha256", "eu_wallet_boundary_adapter_sha256"],
      "properties": {
        "eu_arf_sha256": {"$ref": "#/$defs/sha256"},
        "eu_fcaf_sha256": {"$ref": "#/$defs/sha256"},
        "eu_technical_specifications_sha256": {"$ref": "#/$defs/sha256"},
        "eu_wallet_boundary_adapter_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "certification_claim", "minimum_requirements", "declared_cases", "normative_boundaries"],
      "properties": {
        "authority": {"const": "internal_engineering"},
        "certification_claim": {"const": false},
        "minimum_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "status_counts", "incomplete"],
          "properties": {
            "total": {"type": "integer", "minimum": 1, "maximum": 256},
            "status_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["implemented", "partial", "operational_required", "delegated", "fixture_seeded"],
              "properties": {
                "implemented": {"type": "integer", "minimum": 0},
                "partial": {"type": "integer", "minimum": 0},
                "operational_required": {"type": "integer", "minimum": 0},
                "delegated": {"type": "integer", "minimum": 0},
                "fixture_seeded": {"type": "integer", "minimum": 0}
              }
            },
            "incomplete": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["minimum_id", "status", "limitations"],
                "properties": {
                  "minimum_id": {"$ref": "#/$defs/identifier"},
                  "status": {"enum": ["partial", "operational_required", "delegated", "fixture_seeded"]},
                  "limitations": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        },
        "declared_cases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "executable", "non_executable", "status_counts", "non_executable_cases"],
          "properties": {
            "total": {"type": "integer", "minimum": 1, "maximum": 10000},
            "executable": {"type": "integer", "minimum": 1, "maximum": 10000},
            "non_executable": {"type": "integer", "minimum": 0, "maximum": 10000},
            "status_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unit_covered", "implemented", "fixture_available", "fixture_seeded"],
              "properties": {
                "unit_covered": {"type": "integer", "minimum": 0},
                "implemented": {"type": "integer", "minimum": 0},
                "fixture_available": {"type": "integer", "minimum": 0},
                "fixture_seeded": {"type": "integer", "minimum": 0}
              }
            },
            "non_executable_cases": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["case_id", "status"],
                "properties": {
                  "case_id": {"$ref": "#/$defs/identifier"},
                  "status": {"enum": ["fixture_available", "fixture_seeded"]}
                }
              }
            }
          }
        },
        "normative_boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implemented", "checks"],
          "properties": {
            "implemented": {"type": "integer", "minimum": 1},
            "checks": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "test_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "discovered_test_count", "test_inventory_sha256", "executed_test_count", "passed_test_count", "failed_test_count", "ignored_test_count", "measured_test_count", "filtered_test_count", "declared_executable_case_count", "declared_test_functions_sha256", "result"],
      "properties": {
        "command_id": {"const": "cargo-test-workspace-all-features-v1"},
        "discovered_test_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "test_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "executed_test_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "passed_test_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "failed_test_count": {"const": 0},
        "ignored_test_count": {"const": 0},
        "measured_test_count": {"const": 0},
        "filtered_test_count": {"const": 0},
        "declared_executable_case_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "declared_test_functions_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"const": "passed"}
      }
    },
    "framework_probes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_id", "command_id", "source_sha256", "executed_test_count", "passed_test_count", "failed_test_count", "ignored_test_count", "measured_test_count", "filtered_test_count", "result"],
          "properties": {
            "probe_id": {"const": "wallet-provider-key-storage-boundaries"},
            "command_id": {"const": "cargo-test-framework-key-storage-probe-v1"},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "executed_test_count": {"const": 1},
            "passed_test_count": {"const": 1},
            "failed_test_count": {"const": 0},
            "ignored_test_count": {"const": 0},
            "measured_test_count": {"const": 0},
            "filtered_test_count": {"const": 0},
            "result": {"const": "passed"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_id", "command_id", "source_sha256", "executed_test_count", "passed_test_count", "failed_test_count", "ignored_test_count", "measured_test_count", "filtered_test_count", "result"],
          "properties": {
            "probe_id": {"const": "wallet-key-custody-codec-boundaries"},
            "command_id": {"const": "cargo-test-framework-key-custody-codec-v1"},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "executed_test_count": {"const": 4},
            "passed_test_count": {"const": 4},
            "failed_test_count": {"const": 0},
            "ignored_test_count": {"const": 0},
            "measured_test_count": {"const": 0},
            "filtered_test_count": {"const": 0},
            "result": {"const": "passed"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_id", "command_id", "source_sha256", "executed_test_count", "passed_test_count", "failed_test_count", "ignored_test_count", "measured_test_count", "filtered_test_count", "result"],
          "properties": {
            "probe_id": {"const": "wallet-consent-policy-context-binding"},
            "command_id": {"const": "cargo-test-framework-consent-policy-context-v1"},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "executed_test_count": {"const": 4},
            "passed_test_count": {"const": 4},
            "failed_test_count": {"const": 0},
            "ignored_test_count": {"const": 0},
            "measured_test_count": {"const": 0},
            "filtered_test_count": {"const": 0},
            "result": {"const": "passed"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_id", "command_id", "source_sha256", "executed_test_count", "passed_test_count", "failed_test_count", "ignored_test_count", "measured_test_count", "filtered_test_count", "result"],
          "properties": {
            "probe_id": {"const": "wallet-flow-resume-boundaries"},
            "command_id": {"const": "cargo-test-framework-flow-resume-probe-v1"},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "executed_test_count": {"const": 4},
            "passed_test_count": {"const": 4},
            "failed_test_count": {"const": 0},
            "ignored_test_count": {"const": 0},
            "measured_test_count": {"const": 0},
            "filtered_test_count": {"const": 0},
            "result": {"const": "passed"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_id", "command_id", "source_sha256", "executed_test_count", "passed_test_count", "failed_test_count", "ignored_test_count", "measured_test_count", "filtered_test_count", "result"],
          "properties": {
            "probe_id": {"const": "wallet-lifecycle-boundaries"},
            "command_id": {"const": "cargo-test-framework-lifecycle-probe-v1"},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "executed_test_count": {"const": 3},
            "passed_test_count": {"const": 3},
            "failed_test_count": {"const": 0},
            "ignored_test_count": {"const": 0},
            "measured_test_count": {"const": 0},
            "filtered_test_count": {"const": 0},
            "result": {"const": "passed"}
          }
        }
      ],
      "items": false
    },
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "assertions": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/assertion"}},
    "evidence_policy": {"$ref": "eudi-wallet-conformance-plan.schema.json#/$defs/evidence_policy"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "kind", "result"],
      "properties": {
        "check_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["source", "artifact", "cargo", "probe", "attestation", "normative"]},
        "result": {"enum": ["passed", "failed"]}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "check_ids", "result"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/identifier"},
        "check_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "result": {"enum": ["passed", "failed"]}
      }
    }
  }
}
