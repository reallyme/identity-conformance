{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reallyme.com/identity/conformance-release.schema.json",
  "title": "ReallyMe identity conformance framework release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$comment",
    "schema",
    "release_kind",
    "release_version",
    "repository_commit",
    "input_set_sha256",
    "inputs"
  ],
  "properties": {
    "$comment": {"type": "string"},
    "schema": {"const": "reallyme.identity.conformance_framework_release.v1"},
    "release_kind": {"const": "framework"},
    "release_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "repository_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {"type": "integer", "minimum": 1, "maximum": 16777216}
        }
      }
    }
  }
}
