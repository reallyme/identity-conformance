{
  "$comment": "SPDX-FileCopyrightText: 2026 ReallyMe Technologies Limited\nSPDX-License-Identifier: MIT OR Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://really.me/schemas/identity-conformance/eudi-wallet-conformance-plan-v1.json",
  "title": "ReallyMe EUDI Wallet engineering conformance plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "execution_status", "certification_claim", "source_baseline", "upstream_source_ids", "legal_source_ids", "assertions", "evidence_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"const": "eudi-wallet-engineering-v1"},
    "execution_status": {"const": "executable"},
    "certification_claim": {"const": false},
    "source_baseline": {"$ref": "#/$defs/source"},
    "upstream_source_ids": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "legal_source_ids": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "assertions": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/assertion"}},
    "evidence_policy": {"$ref": "#/$defs/evidence_policy"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source_ref", "commit"],
      "properties": {
        "repository": {"const": "https://github.com/reallyme/wallet"},
        "source_ref": {"const": "main"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "required_checks"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/identifier"},
        "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_sensitive_data", "raw_process_output_retained", "credential_payloads_retained", "private_key_material_retained"],
      "properties": {
        "contains_sensitive_data": {"const": false},
        "raw_process_output_retained": {"const": false},
        "credential_payloads_retained": {"const": false},
        "private_key_material_retained": {"const": false}
      }
    }
  }
}
