{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.really.me/identity-conformance/conformance-selection.schema.json",
  "title": "ReallyMe conformance profile selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_kind", "product_version", "capabilities", "requested_badge_id", "selected_profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "product_kind": {"type": "string", "enum": ["identity", "wallet", "zk"]},
    "product_version": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,127}$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}
    },
    "requested_badge_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "selected_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    }
  }
}
