{
  "$comment": "SPDX-FileCopyrightText: 2026 ReallyMe Technologies Limited\nSPDX-License-Identifier: MIT OR Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://really.me/schemas/identity-conformance/eudi-execution-result-v1.json",
  "title": "ReallyMe EUDI relying-party conformance execution result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "mode", "result", "created_at", "components", "artifact_sha256", "trust_artifact_sha256", "credential_authority_artifact_sha256", "component_attestation_sha256", "source_locks", "upstream_sources", "checks", "assertions", "evidence_policy"],
  "properties": {
    "schema": {"const": "reallyme.identity.eudi_execution_result.v1"},
    "plan_id": {"const": "eudi-relying-party-control-plane-v1"},
    "mode": {"enum": ["engineering", "deployed", "live_ts5"]},
    "result": {"enum": ["passed", "failed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/component"}
    },
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "trust_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "credential_authority_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "component_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "source_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eudi_sources_sha256", "eudi_legal_sources_sha256", "eudi_publications_sha256"],
      "properties": {
        "eudi_sources_sha256": {"$ref": "#/$defs/sha256"},
        "eudi_legal_sources_sha256": {"$ref": "#/$defs/sha256"},
        "eudi_publications_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "upstream_sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/upstream_source"}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "assertions": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {"$ref": "#/$defs/assertion"}
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_sensitive_data", "raw_process_output_retained", "transaction_content_retained", "private_key_material_retained", "credentials_retained"],
      "properties": {
        "contains_sensitive_data": {"const": false},
        "raw_process_output_retained": {"const": false},
        "transaction_content_retained": {"const": false},
        "private_key_material_retained": {"const": false},
        "credentials_retained": {"const": false}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "repository", "commit"],
      "properties": {
        "component_id": {"enum": ["eudi", "platform", "ssi"]},
        "repository": {"type": "string", "pattern": "^https://github\\.com/reallyme/[A-Za-z0-9_.-]+$"},
        "commit": {"$ref": "#/$defs/git_commit"}
      }
    },
    "upstream_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "repository", "ref", "commit"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "repository": {"type": "string", "pattern": "^https://github\\.com/eu-digital-identity-wallet/[A-Za-z0-9_.-]+$"},
        "ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "commit": {"$ref": "#/$defs/git_commit"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "kind", "result"],
      "properties": {
        "check_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["attestation", "binary_probe", "service_probe", "live_probe"]},
        "result": {"enum": ["passed", "failed"]}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "assertion_id", "result", "check_ids"],
      "properties": {
        "family_id": {"$ref": "#/$defs/identifier"},
        "assertion_id": {"$ref": "#/$defs/identifier"},
        "result": {"enum": ["passed", "failed"]},
        "check_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
