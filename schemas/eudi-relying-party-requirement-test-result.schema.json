{
  "$comment": "SPDX-FileCopyrightText: 2026 ReallyMe Technologies Limited\nSPDX-License-Identifier: MIT OR Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://really.me/schemas/identity-conformance/eudi-relying-party-requirement-test-result-v1.json",
  "title": "ReallyMe EUDI relying-party requirement test result",
  "type": "object",
  "additionalProperties": false,
  "required": ["$comment", "schema", "command_id", "assertion_id", "evidence_class", "status", "exit_code", "stdout_sha256", "stderr_sha256", "metadata_only"],
  "properties": {
    "$comment": {"type": "string", "minLength": 1},
    "schema": {"const": "reallyme.identity.eudi_requirement_test_result.v1"},
    "command_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "assertion_id": {"enum": ["association_is_service_to_service", "current_ts5_signed_envelope_is_strict"]},
    "evidence_class": {"enum": ["behavior_test", "downgrade_test", "invalid_input_test", "oversized_input_test", "round_trip_test"]},
    "status": {"enum": ["passed", "failed", "error"]},
    "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata_only": {"const": true}
  }
}
