{
  "$comment": "SPDX-FileCopyrightText: 2026 ReallyMe Technologies Limited\nSPDX-License-Identifier: MIT OR Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://really.me/schemas/identity-conformance/zk-execution-result-v1.json",
  "title": "ReallyMe ZK conformance execution result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "result", "created_at", "component", "release_artifact_sha256", "component_attestation_sha256", "checks", "assertions", "evidence_policy"],
  "properties": {
    "schema": {"const": "reallyme.identity.zk_execution_result.v1"},
    "plan_id": {"const": "zk-presentation-proofs-v1"},
    "result": {"enum": ["passed", "failed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "component": {"$ref": "zk-deployment-manifest.schema.json#/properties/component"},
    "release_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "component_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "assertions": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/assertion"}},
    "evidence_policy": {"$ref": "zk-conformance-plan.schema.json#/$defs/evidence_policy"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "kind", "result"],
      "properties": {
        "check_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["source", "artifact", "cargo", "attestation"]},
        "result": {"enum": ["passed", "failed"]}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "check_ids", "result"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/identifier"},
        "check_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "result": {"enum": ["passed", "failed"]}
      }
    }
  }
}
