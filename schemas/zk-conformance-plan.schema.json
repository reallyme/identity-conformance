{
  "$comment": "SPDX-FileCopyrightText: 2026 ReallyMe Technologies Limited\nSPDX-License-Identifier: MIT OR Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://really.me/schemas/identity-conformance/zk-conformance-plan-v1.json",
  "title": "ReallyMe ZK presentation-proof conformance plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "execution_status", "certification_claim", "required_components", "assertions", "evidence_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"const": "zk-presentation-proofs-v1"},
    "execution_status": {"const": "executable"},
    "certification_claim": {"const": false},
    "required_components": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/component_requirement"}},
    "assertions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "required_checks"],
        "properties": {
          "assertion_id": {"$ref": "#/$defs/identifier"},
          "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
        }
      }
    },
    "evidence_policy": {"$ref": "#/$defs/evidence_policy"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "component_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "repository"],
      "properties": {
        "component_id": {"const": "zk"},
        "repository": {"const": "https://github.com/reallyme/zk"}
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_sensitive_data", "raw_process_output_retained", "witness_material_retained", "private_key_material_retained"],
      "properties": {
        "contains_sensitive_data": {"const": false},
        "raw_process_output_retained": {"const": false},
        "witness_material_retained": {"const": false},
        "private_key_material_retained": {"const": false}
      }
    }
  }
}
