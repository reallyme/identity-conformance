{
  "$comment": "SPDX-FileCopyrightText: 2026 ReallyMe Technologies Limited\nSPDX-License-Identifier: MIT OR Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://really.me/schemas/identity-conformance/eudi-wallet-deployment-manifest-v1.json",
  "title": "ReallyMe EUDI Wallet deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "component", "release_artifact", "component_attestation_sha256", "source_locks", "evidence_policy"],
  "properties": {
    "schema": {"const": "reallyme.identity.eudi_wallet_deployment_manifest.v1"},
    "plan_id": {"const": "eudi-wallet-engineering-v1"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "repository", "commit"],
      "properties": {
        "component_id": {"const": "wallet"},
        "repository": {"const": "https://github.com/reallyme/wallet"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "release_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "sha256"],
      "properties": {
        "artifact_id": {"const": "wallet-release-bundle"},
        "kind": {"const": "archive"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "component_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "source_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eudi_sources_sha256", "eudi_legal_sources_sha256", "eudi_publications_sha256"],
      "properties": {
        "eudi_sources_sha256": {"$ref": "#/$defs/sha256"},
        "eudi_legal_sources_sha256": {"$ref": "#/$defs/sha256"},
        "eudi_publications_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_policy": {"$ref": "eudi-wallet-conformance-plan.schema.json#/$defs/evidence_policy"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
