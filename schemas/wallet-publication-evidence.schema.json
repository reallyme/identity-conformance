{
  "$comment": "SPDX-FileCopyrightText: 2026 ReallyMe Technologies Limited\nSPDX-License-Identifier: MIT OR Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://really.me/schemas/identity-conformance/wallet-publication-evidence-v1.json",
  "title": "ReallyMe Wallet publication evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release", "release_assets", "release_asset_inventory_sha256", "registry_packages", "registry_package_inventory_sha256"],
  "properties": {
    "schema": {"const": "reallyme.identity.wallet_publication_evidence.v1"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref", "version", "commit"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "ref": {"type": "string", "pattern": "^reallyme-wallet-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "version": {"$ref": "eudi-wallet-deployment-manifest.schema.json#/$defs/semver"},
        "commit": {"$ref": "eudi-wallet-deployment-manifest.schema.json#/$defs/git_commit"}
      }
    },
    "release_assets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 130,
      "items": {"$ref": "#/$defs/releaseAsset"}
    },
    "release_asset_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "registry_packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/registryPackage"}
    },
    "registry_package_inventory_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "releaseAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "registryPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "checksum", "yanked"],
      "properties": {
        "name": {"type": "string", "pattern": "^reallyme-wallet(?:-[a-z0-9][a-z0-9-]{0,63})?$"},
        "version": {"$ref": "eudi-wallet-deployment-manifest.schema.json#/$defs/semver"},
        "checksum": {"$ref": "#/$defs/sha256"},
        "yanked": {"const": false}
      }
    }
  }
}
