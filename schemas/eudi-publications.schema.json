{
  "$comment": "SPDX-FileCopyrightText: 2026 ReallyMe Technologies Limited\nSPDX-License-Identifier: MIT OR Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://really.me/schemas/identity-conformance/eudi-publications-v1.json",
  "title": "EUDI external publication pins",
  "type": "object",
  "additionalProperties": false,
  "required": ["$comment", "schema", "observed_on", "scope", "publications", "delegated_bindings"],
  "properties": {
    "$comment": {"type": "string"},
    "schema": {"const": "reallyme.identity.eudi_publications.v1"},
    "observed_on": {"type": "string", "format": "date"},
    "scope": {"const": ["wallet", "eidas_2", "oidf"]},
    "publications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/publication"}},
    "delegated_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/delegated"}}
  },
  "$defs": {
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "publisher", "edition", "publication_date", "maturity", "canonical_url", "certification_claim", "binding"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"enum": ["ISO/IEC", "IETF", "W3C", "ETSI"]},
        "edition": {"type": "string", "minLength": 1},
        "publication_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "maturity": {"enum": ["published_standard", "working_draft"]},
        "canonical_url": {"type": "string", "pattern": "^https://"},
        "certification_claim": {"const": false},
        "binding": {"oneOf": [{"$ref": "#/$defs/content_binding"}, {"$ref": "#/$defs/edition_binding"}]}
      }
    },
    "content_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sha256", "content_length"],
      "properties": {
        "kind": {"const": "content_sha256"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_length": {"type": "integer", "minimum": 1, "maximum": 4194304}
      }
    },
    "edition_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "standard_number", "copyright_restricted", "local_copy_allowed"],
      "properties": {
        "kind": {"const": "official_edition"},
        "standard_number": {"type": "string", "pattern": "^ISO/IEC"},
        "copyright_restricted": {"const": true},
        "local_copy_allowed": {"const": false}
      }
    },
    "delegated": {
      "type": "object", "additionalProperties": false,
      "required": ["publication_id", "lock_path", "target_id"],
      "properties": {
        "publication_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "lock_path": {"enum": ["upstream/oidf/specifications.lock.json", "references/normative-sources.lock.json"]},
        "target_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}
      }
    }
  }
}
