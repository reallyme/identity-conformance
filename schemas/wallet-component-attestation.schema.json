{
  "$comment": "SPDX-FileCopyrightText: 2026 ReallyMe Technologies Limited\nSPDX-License-Identifier: MIT OR Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://really.me/schemas/identity-conformance/wallet-component-attestation-v2.json",
  "title": "ReallyMe Wallet target attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "component", "target", "artifacts", "dependency_lock", "toolchain", "checks", "created_at", "evidence_policy"],
  "properties": {
    "schema": {"const": "reallyme.identity.wallet_component_attestation.v2"},
    "classification": {"const": "internal"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "repository", "source_commit"],
      "properties": {
        "component_id": {"const": "wallet"},
        "repository": {"const": "https://github.com/reallyme/wallet"},
        "source_commit": {"$ref": "#/$defs/git_commit"}
      }
    },
    "target": {"$ref": "eudi-wallet-deployment-manifest.schema.json#/$defs/target"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "sha256"],
        "properties": {
          "artifact_id": {"$ref": "#/$defs/identifier"},
          "kind": {"enum": ["binary", "oci_image", "archive", "package", "circuit_artifact", "metadata"]},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "dependency_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": {"const": "cargo"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "version"],
      "properties": {
        "identifier": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "category", "result", "evidence_sha256"],
        "properties": {
          "check_id": {"$ref": "#/$defs/identifier"},
          "category": {"enum": ["format", "lint", "unit", "integration", "property", "fuzz", "vector", "security", "build"]},
          "result": {"const": "passed"},
          "evidence_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "evidence_policy": {"$ref": "component-attestation.schema.json#/properties/evidence_policy"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
