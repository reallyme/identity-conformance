      "api": "https://www.certification.openid.net/",
      "mtls": "https://mtls-www.certification.openid.net/"
    },
    "module_inventory_authority": "The modules array returned by POST /api/plan for the exact plan, variant selection, configuration, and suite revision.",
    "run_every_returned_module": true,
    "allow_selected_modules": false,
    "allow_rerun_filter_for_certification_evidence": false,
    "allow_expected_failures": false,
    "allow_expected_skips": false,
    "required_module_results": {
      "openid4vci": [
        "PASSED"
      ],
      "openid4vp_default": [
        "PASSED"
      ],
      "openid4vp_source_bound_review": [
        "REVIEW"
      ]
    },
    "openid4vp_result_policy_authority": "conformance/oidf/profile-matrix.json in the exact locked openid4vp component revision",
    "required_completion_assertions": [
      "No :module-list selector is present in the plan expression.",
      "The runner's selected_modules value is empty.",
      "The number of completed module results equals the number of modules returned when the plan was created.",
      "The runner does not emit NOT ALL TESTS FROM PLAN WERE RUN.",
      "OpenID4VCI exports contain only PASSED terminal module results.",
      "OpenID4VP exports contain PASSED terminal results except REVIEW for exact modules classified by the source-bound result policy in the locked OpenID4VP certification matrix.",
      "No export contains failed, warning, interrupted, incomplete, or unclassified review results.",
      "The exported module inventory and result archive are retained with cryptographic hashes in the release BOM."
    ],
    "inventory_capture_timing": "Capture after authenticated plan creation because module applicability and per-module variants are resolved by the running suite from the selected plan variants. Do not substitute a regex-derived source-file inventory."
  },
